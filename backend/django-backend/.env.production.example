# Template for the production backend environment.
# Copy to backend/django-backend/.env on the VPS and fill in real values.
# NEVER commit the real .env file to Git.

# --- Database (PostgreSQL on the same VPS) ---
DATABASE_URL=postgresql://visions:CHANGE_ME_DB_PASSWORD@localhost:5432/vision_global_empowerment

# --- Django ---
# Generate with: openssl rand -base64 50
DJANGO_SECRET_KEY=CHANGE_ME_GENERATED_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=visionseducation.in,www.visionseducation.in,127.0.0.1,localhost

# --- Frontend / CORS / CSRF ---
FRONTEND_URL=https://visionseducation.in
CORS_ALLOWED_ORIGINS=https://visionseducation.in,https://www.visionseducation.in
CSRF_TRUSTED_ORIGINS=https://visionseducation.in,https://www.visionseducation.in

# --- Email (Hostinger mailbox) ---
DEFAULT_FROM_EMAIL=noreply@visionseducation.in
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_MAILBOX
EMAIL_HOST_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
EMAIL_USE_TLS=True
